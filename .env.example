# Postgres connection string (Neon / Supabase pooled URL / Vercel Postgres). Then run: npm run db:setup
DATABASE_URL=
# Stable production URL used in emailed links, e.g. https://yourdomain.vercel.app (NOT a per-deployment URL)
APP_URL=
# Email service configuration (SMTP via Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=University Portal <no-reply@yourdomain.com>
# Optional: administrator email address for receiving recovery request notifications
ADMIN_EMAIL=
# Google OAuth client ID. NEXT_PUBLIC_ is inlined at build time -> redeploy after changing.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
# Long random string used to sign session cookies
JWT_SECRET=
# Optional but recommended in production: shared rate-limit store (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Product photo uploads (Vercel Blob). Create a Blob store in Vercel > Storage; it sets this for you.
# Without it, uploads work in development only (saved under public/uploads).
BLOB_READ_WRITE_TOKEN=
