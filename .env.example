# Postgres connection string (Neon / Supabase pooled URL / Vercel Postgres). Then run: npm run db:setup
DATABASE_URL=
# Stable production URL used in emailed links, e.g. https://yourdomain.vercel.app (NOT a per-deployment URL)
APP_URL=
# Email service configuration (SMTP via Nodemailer)
# Either SMTP_* below, or just RESEND_API_KEY (uses smtp.resend.com automatically).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=University Portal <no-reply@yourdomain.com>
# Optional: administrator email address for receiving recovery request notifications
ADMIN_EMAIL=
# Google OAuth client ID. NEXT_PUBLIC_ is inlined at build time -> redeploy after changing.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
# Long random string used to sign session cookies
JWT_SECRET=
# Optional but recommended in production: shared rate-limit store (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Product photo uploads (Vercel Blob). Create a Blob store in Vercel > Storage; it sets this for you.
# Without it, uploads work in development only (saved under public/uploads).
BLOB_READ_WRITE_TOKEN=

# Public site / SEO
# APP_HOST=cafe.example.edu.in          # canonical host; www.<APP_HOST> 301s to it
# ORG_URL=https://www.poornima.edu.in   # university website for structured data (confirm before setting)
# NEXT_PUBLIC_SUPPORT_EMAIL=            # shown on public pages (default support@poornima.edu.in)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX        # Google Analytics 4, loaded on public pages after consent only
# NEXT_PUBLIC_GSC_VERIFICATION=         # Search Console HTML-tag verification token
# SECURITY_CONTACT=security@...         # enables /.well-known/security.txt (must be a monitored mailbox)
# CONTACT_TO=                           # where contact-form messages go (falls back to ADMIN_EMAIL)

# Online payments (Razorpay). Without the key id + secret, only "cash at counter" is offered.
# Test mode keys start with rzp_test_. Webhook: https://<APP_URL>/api/payments/razorpay/webhook,
# events payment.captured + order.paid, with the same secret as RAZORPAY_WEBHOOK_SECRET.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
